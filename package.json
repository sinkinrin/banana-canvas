{
  "name": "banana-canvas",
  "private": true,
  "version": "0.4.0",
  "description": "本地优先的 AI 图像创作画布，默认使用 Image2 并支持应用内连接配置。",
  "author": "Banana Canvas Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinkinrin/banana-canvas.git"
  },
  "homepage": "https://github.com/sinkinrin/banana-canvas#readme",
  "bugs": {
    "url": "https://github.com/sinkinrin/banana-canvas/issues"
  },
  "type": "module",
  "main": "build/electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --outdir=build/electron --out-extension:.js=.cjs --external:electron --external:vite",
    "electron": "npm run build && npm run build:electron && electron .",
    "smoke:electron": "npm run build && npm run build:electron && node scripts/electron-smoke.mjs",
    "smoke:electron:packaged": "node scripts/electron-smoke.mjs \"release/win-unpacked/香蕉画图.exe\"",
    "dist:win": "npm run clean:release && npm run build && npm run build:electron && node scripts/build-windows.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:release": "node -e \"require('node:fs').rmSync('release',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" server.ts vite.config.ts",
    "test": "node scripts/run-tests.mjs",
    "version:check": "node scripts/verify-version.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm test && npm run build && npm run build:electron"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@quickdrawjs/react": "0.2.0",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.29.0",
    "uuid": "^14.0.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "fast-uri": "^3.1.6",
    "postcss": "^8.5.26",
    "protobufjs": "^7.6.5",
    "qs": "^6.15.3",
    "ws": "^8.21.1"
  },
  "build": {
    "appId": "com.banana.canvas",
    "productName": "香蕉画图",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sinkinrin",
        "repo": "banana-canvas"
      }
    ],
    "files": [
      "build/electron/*.cjs",
      "dist/**/*",
      ".env.example",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "banana-canvas-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
